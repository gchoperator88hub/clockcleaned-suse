{
  "name": "clockcleaned",
  "version": "1.0.0",
  "private": true,
  "description": "My Hugging Face Clock App for openSUSE and Linux Mint",
  "author": "gchoperator88hub <test@test.com>",
  "main": "main.js",
  "scripts": {
    "dev": "npx serve public -l 7860",
    "build": "node ./scripts/build.mjs",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.clockcleaned.app",
    "productName": "ClockCleaned",
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "rpm",
        "AppImage",
        "flatpak"
      ],
      "category": "Utility"
    },
    "flatpak": {
      "runtimeVersion": "23.08"
    }
  },
  "dependencies": {
    "serve": "^14.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "electron": "28.2.0",
    "electron-builder": "24.13.3"
  }
}
